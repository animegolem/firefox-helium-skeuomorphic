<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key><string>helium-slate.watch</string>
  <key>ProgramArguments</key>
  <array>
    <string>/bin/zsh</string>
    <string>__INSTALL_SH__</string>
    <string>--app-only</string>
  </array>
  <!-- Firefox updates rewrite Info.plist; re-copy the autoconfig stub then. -->
  <key>WatchPaths</key>
  <array><string>/Applications/Firefox.app/Contents/Info.plist</string></array>
  <key>RunAtLoad</key><true/>
  <key>StandardOutPath</key><string>/tmp/helium-slate.log</string>
  <key>StandardErrorPath</key><string>/tmp/helium-slate.log</string>
</dict>
</plist>
